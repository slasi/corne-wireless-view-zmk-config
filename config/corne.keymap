#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <200>;
    tapping-term-ms = <250>;
    require-prior-idle-ms = <125>;
};

&lt {
    quick-tap-ms = <200>;
    tapping-term-ms = <250>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "base";
            bindings = <
&caps_word  &kp Q        &kp W        &kp E        &kp R           &kp T                      &kp Y                    &kp U        &kp I            &kp O         &kp P           &kp LG(LC(Q))
&lt 3 ESC   &mt LALT A   &mt LCTRL S  &mt LGUI D   &mt LSHFT F     &mt LA(LC(LG(LSHFT))) G    &mt RA(RC(RG(RSHFT))) H  &mt RSHFT J  &mt RGUI K       &mt RCTRL L   &mt RALT SEMI   &lt 3 SQT
&kp F19     &mt LCTRL Z  &mt LGUI X   &mt LSHFT C  &mt LEFT_ALT V  &kp B                      &kp N                    &mt RALT M   &mt RSHFT COMMA  &mt RGUI DOT  &mt RCTRL FSLH  &kp F20
                                      &lt 3 ESC    &lt 1 RETURN    &lt 2 TAB                  &lt 2 BSPC               &lt 1 SPACE  &lt 3 SQT
            >;
        };

        symnum_layer {
            display-name = "SymNum";
            bindings = <
&none    &kp EXCL     &kp AT        &kp HASH     &kp DOLLAR    &kp PRCNT    &kp CARET  &kp AMPS      &kp STAR     &kp LPAR      &kp RPAR     &none
&none    &mt LALT N1  &mt LCTRL N2  &mt LGUI N3  &mt LSHFT N4  &kp N5       &kp N6     &mt RSHFT N7  &mt RGUI N8  &mt RCTRL N9  &mt RALT N0  &kp DELETE
&kp F21  &kp BSLH     &kp GRAVE     &kp LBRC     &kp LBKT      &kp MINUS    &kp EQUAL  &kp RBKT      &kp RBRC     &kp DOT       &kp FSLH     &kp F22
                                    &trans       &trans        &trans       &trans     &trans        &trans
            >;
        };

        navtext_layer {
            display-name = "NavText";
            bindings = <
&none    &kp LC(A)      &kp LA(LC(B))    &kp LA(LC(F))   &kp LC(E)      &kp LC(P)    &kp LA(LEFT_ARROW)  &kp LA(DOWN_ARROW)    &kp LA(UP_ARROW)  &kp LA(RIGHT_ARROW)  &none           &none
&none    &mt LALT HOME  &mt LCTRL PG_UP  &mt LGUI PG_DN  &mt LSHFT END  &kp LC(N)    &kp LEFT_ARROW      &mt RSHFT DOWN_ARROW  &mt RGUI UP       &mt RCTRL RIGHT      &mt LALT RC(L)  &none
&kp F23  &kp LC(U)      &kp LC(B)        &kp LC(F)       &kp LC(D)      &none        &kp RG(LEFT)        &kp RG(DOWN)          &kp RG(UP)        &kp RG(RIGHT)        &none           &kp F24
                                         &trans          &trans         &trans       &trans              &trans                &trans
            >;
        };

        fnsysbt_layer {
            display-name = "FnSysBT";
            bindings = <
&kp LC(DOWN)  &kp C_BRIGHTNESS_DEC  &kp C_BRI_UP  &kp LC(LEFT)  &kp LC(RIGHT)  &kp LC(UP)      &kp K_PREV  &kp K_PP              &kp K_NEXT             &kp K_MUTE            &kp C_VOL_DN  &kp C_VOL_UP
&kp F12       &mt LALT F1           &mt LCTRL F2  &mt LGUI F3   &mt LSHFT F4   &kp F5          &kp F6      &mt RSHFT F7          &mt RGUI F8            &mt RIGHT_CONTROL F9  &mt RALT F10  &kp F11
&bt BT_CLR    &bt BT_SEL 0          &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3   &bt BT_SEL 4    &none       &kp LG(LEFT_BRACKET)  &kp LG(RIGHT_BRACKET)  &kp LG(TILDE)         &none         &none
                                                  &trans        &trans         &trans          &trans      &trans                &trans
            >;
        };
    };
};
